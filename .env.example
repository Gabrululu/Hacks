# Set by pnpm exec convex dev after linking a deployment
VITE_CONVEX_URL=
# HTTP actions URL for auth setup, uploads and downloads; local: http://127.0.0.1:3211
VITE_CONVEX_SITE_URL=
# Configure on Convex, never expose these in VITE_ variables:
# SUPERADMIN_WALLETS=

# Include demo cards alongside published Convex events; false hides examples
VITE_DEMO_MODE=false

# Login uses Convex even when VITE_DEMO_MODE=false.
# Run pnpm auth:setup:local for the existing anonymous local deployment.
# Server-only auth variables (configure on Convex, never under VITE_):
# AUTH_ISSUER, AUTH_HOME_DOMAIN, AUTH_KEY_ID, AUTH_PRIVATE_KEY,
# AUTH_PUBLIC_JWKS, STELLAR_AUTH_SECRET

# Server-only email variables (configure on Convex):
# RESEND_API_KEY, RESEND_FROM_EMAIL, RESEND_WEBHOOK_SECRET, EMAIL_VERIFICATION_SECRET
# EMAIL_DELIVERY_MODE=resend
# APP_URL=https://hacks.mintedinpe.com (base de enlaces de invitación, resultados y baja)
# Local mailbox only: pnpm email:setup:local

# Resend webhook: https://<deployment>.convex.site/resend-webhook
# Configure signing secret on Convex; never paste secrets in chat or use VITE_ variables.
